{
  "name": "pundit-temp",
  "version": "1.3.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "dev:functions": "netlify functions:serve --functions netlify/functions --port 9999",
    "dev:netlify": "netlify dev --port 8888 --targetPort 8081",
    "dev:mobile": "expo start --clear",
    "log:start": "node scripts/run-with-log.js -- npm start",
    "log:web": "node scripts/run-with-log.js -- npm run web",
    "log:dev:functions": "node scripts/run-with-log.js -- npm run dev:functions",
    "log:dev:netlify": "node scripts/run-with-log.js -- npm run dev:netlify",
    "log:dev:mobile": "node scripts/run-with-log.js -- npm run dev:mobile",
    "seed:demo-leaderboard": "node scripts/seed-demo-leaderboard.js",
    "inspect:leaderboard-performance": "node scripts/inspect-leaderboard-performance.js",
    "repair:total-correct": "node scripts/repair-total-correct.js",
    "eas:login": "npx eas-cli@latest login",
    "build:ios:device": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:testflight": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "testflight": "npx testflight"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.11.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "^8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-font": "^14.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-auth0": "^5.5.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@types/pg": "^8.16.0",
    "@types/react": "~19.1.0",
    "dotenv": "^17.2.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true
}
