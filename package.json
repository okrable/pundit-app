{
  "name": "pundit-temp",
  "version": "2.9.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/check-web-bundle.js",
    "dev:functions": "netlify functions:serve --functions netlify/functions --port 9999",
    "dev:netlify": "netlify dev --port 8888 --targetPort 8081",
    "dev:mobile": "expo start --clear",
    "log:start": "node scripts/run-with-log.js -- npm start",
    "log:web": "node scripts/run-with-log.js -- npm run web",
    "log:dev:functions": "node scripts/run-with-log.js -- npm run dev:functions",
    "log:dev:netlify": "node scripts/run-with-log.js -- npm run dev:netlify",
    "log:dev:mobile": "node scripts/run-with-log.js -- npm run dev:mobile",
    "seed:demo-leaderboard": "node scripts/seed-demo-leaderboard.js",
    "inspect:leaderboard-performance": "node scripts/inspect-leaderboard-performance.js",
    "audit:profile-avatars": "node scripts/audit-profile-avatars.js",
    "audit:bigquery-questions": "node scripts/audit-bigquery-questions.js",
    "repair:total-correct": "node scripts/repair-total-correct.js",
    "eas:login": "npx eas-cli@latest login",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile ios-simulator",
    "build:ios:development": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:device": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:testflight": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "testflight": "npx testflight",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@google-cloud/bigquery": "^8.3.1",
    "@netlify/aws-lambda-compat": "^1.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/drawer": "^7.13.5",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.11.0",
    "expo": "~55.0.28",
    "expo-auth-session": "~55.0.17",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-web-browser": "~55.0.18",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.25.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@types/pg": "^8.16.0",
    "@types/react": "~19.2.10",
    "dotenv": "^17.2.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "react-native-worklets": "0.7.4"
  },
  "private": true
}
