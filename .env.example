# CockroachDB Connection (Server-side only - for Netlify Functions)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=verify-full

# Auth0 Configuration
# Server-side (used by Netlify Functions to validate bearer tokens via /userinfo)
AUTH0_DOMAIN=your-tenant.auth0.com

# Client-side (used by the Expo app for Auth0 login + refresh token exchange)
# IMPORTANT: Must use EXPO_PUBLIC_ prefix for client-side environment variables
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-client-id

# Optional Auth0 values
# These are not currently used by this repo's app or Netlify functions.
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_AUDIENCE=your-api-identifier

# API Configuration (Client-side - Expo app)
# IMPORTANT: Must use EXPO_PUBLIC_ prefix for client-side environment variables
# For local development with Netlify Dev:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8888/.netlify/functions
#
# For production (replace with your actual Netlify URL):
EXPO_PUBLIC_API_BASE_URL=https://your-app.netlify.app/.netlify/functions

# Quiz day timezone configuration
# Keep server/client values aligned to avoid day-boundary mismatches
QUIZ_TIMEZONE=Europe/London
EXPO_PUBLIC_QUIZ_TIMEZONE=Europe/London
